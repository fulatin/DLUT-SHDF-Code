    prompt "Enable experiment 1"
    default n
    depends on COURSE_EXPERIMENT_ENABLE
    help
        This enable the suppert for experiment 1

if ENABLE_EXPERIMENT_1
osource "application/course_experiment/experiment1/Kconfig"
endif

